USB\SNBC.DeviceDesc4="USB Device Driver for Scanner and Printer"
USB\SNBC.DeviceDesc5="USB Device Driver for Scanner and Printer"
USB\SNBC.DeviceDesc6="USB Device Driver for Scanner and Printer"

BYSUSB.SvcDesc="USB Scanner and Printer Driver"
Disk="SNBC Scanner and Printer Device Driver"
