[PreCopySection]
HKR,,NoSetupUI,,1

[DestinationDirs]
BYSUSB.Files.Ext = 10,System32\Drivers

[BYSUSB.Dev]
CopyFiles=BYSUSB.Files.Ext
AddReg=BYSUSB.AddReg

[BYSUSB.Dev.NTx86]
CopyFiles=BYSUSB.Files.Ext
AddReg=BYSUSB.AddReg

[BYSUSB.Dev.NTx86.Services]
Addservice = BYSUSB, 0x00000002, BYSUSB.AddService

[BYSUSB.Dev.Services]
Addservice = BYSUSB, 0x00000002, BYSUSB.AddService

[BYSUSB.Dev.NTamd64]
CopyFiles=BYSUSB.Files.Ext
AddReg=BYSUSB.AddReg

[BYSUSB.Dev.NTamd64.Services]
Addservice = BYSUSB, 0x00000002, BYSUSB.AddService

[BYSUSB.AddService]
DisplayName    = %BYSUSB.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_AUTO_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\BYSUSB.sys
LoadOrderGroup = Base

[BYSUSB.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,BYSUSB.sys
;HKLM,"System\Currentcontrolset\Services\BYSUSB\Parameters","MaximumTransferSize",0x10001,4096
;HKLM,"System\Currentcontrolset\Services\BYSUSB\Parameters","DebugLevel",0x10001,2


[BYSUSB.Files.Ext]
BYSUSB.sys

[SourceDisksFiles]
BYSUSB.sys=99

[SourceDisksNames]
99=%Disk%,,

